# ============================================================
# 数据库配置
# ============================================================
# 开发环境用 SQLite；生产环境用 PostgreSQL（见 docker-compose.yml）
DATABASE_URL=sqlite+aiosqlite:///./yibao.db
# DATABASE_URL=postgresql+asyncpg://yibao:your-password@localhost:5432/yibao

# Redis配置（缓存/会话）
REDIS_URL=redis://localhost:6379

# ============================================================
# LLM 配置（三级降级：SenseNova → DashScope → 规则引擎）
# ============================================================
# 主力 LLM：商汤日日新 SenseNova
LLM_API_KEY=your-sensenova-api-key
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=sensenova-6.7-flash-lite

# 备选 LLM：阿里云 DashScope（通义千问）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ============================================================
# 向量库配置
# ============================================================
CHROMA_PERSIST_DIR=./chroma_data

# ============================================================
# OCR 服务（OCR.space）
# ============================================================
OCR_API_KEY=your-ocr-space-api-key
OCR_API_URL=https://api.ocr.space/parse/image

# ============================================================
# 安全配置（生产环境必填）
# ============================================================
# API 鉴权 Key（不配置则进入 Demo 开放模式；生产环境必须配置）
YIBAO_API_KEY=your-secure-api-key-here

# 会话 Token 加密盐值（生产环境必须替换为随机字符串）
YIBAO_SESSION_SECRET=please-change-this-to-a-random-secret

# CORS 允许的源（逗号分隔；生产环境必须收敛为具体域名）
# 示例：CORS_ORIGINS=https://yibao.example.com,https://www.yibao.example.com
CORS_ORIGINS=*

# ============================================================
# EEG 设备配置（可选，真实设备接入时使用）
# ============================================================
# EEG_DEVICE_TYPE=muse_lsl
# EEG_LSL_STREAM_NAME=auto
# EEG_LSL_STREAM_TYPE=EEG
# EEG_ACQUIRE_SECONDS=4

# ============================================================
# 路演 / 大赛 Demo
# ============================================================
# 离线模式：跳过 LLM/知识库，全程关键词+mock（无网络依赖，现场演示推荐）
DEMO_OFFLINE=true

# DEAP 数据集目录（用于 validate_deap.py 真实验证，可选）
# DEAP_DIR=D:/data/DEAP
