{"slide": {"content": "<slide xmlns=\"http://www.larkoffice.com/sml/2.0\">\n  <style>\n    <fill>\n      <fillColor color=\"linear-gradient(135deg,rgba(30,60,114,1) 0%,rgba(59,130,246,1) 100%)\"/>\n    </fill>\n  </style>\n  <data>\n    <shape type=\"text\" topLeftX=\"80\" topLeftY=\"60\" width=\"800\" height=\"60\">\n  <content textType=\"title\" textAlign=\"center\" color=\"rgb(255,255,255)\" bold=\"true\" fontSize=\"56\">\n    <p>\u533b\u4fdd\u667a\u8111</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"80\" topLeftY=\"130\" width=\"800\" height=\"40\">\n  <content textType=\"sub-headline\" textAlign=\"center\" color=\"rgb(203,213,224)\" fontSize=\"24\">\n    <p>\u8ba9\u6bcf\u4e2a\u53c2\u4fdd\u4eba\u62e5\u6709\u4e00\u4e2a\u61c2\u533b\u4fdd\u3001\u61c2\u5065\u5eb7\u3001\u61c2\u653f\u7b56\u7684 AI \u7ba1\u5bb6</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"120\" topLeftY=\"220\" width=\"220\" height=\"180\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgba(255,255,255,0.1)\"/>\n  </fill>\n  <border color=\"rgba(255,255,255,0.2)\" width=\"1\"/>\n</shape>\n<shape type=\"text\" topLeftX=\"140\" topLeftY=\"250\" width=\"180\" height=\"40\">\n  <content textType=\"sub-headline\" textAlign=\"center\" color=\"rgb(255,255,255)\" bold=\"true\" fontSize=\"20\">\n    <p>\u542c\u61c2\u4f60\u8bf4\u4ec0\u4e48</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"140\" topLeftY=\"310\" width=\"180\" height=\"60\">\n  <content textType=\"body\" textAlign=\"center\" color=\"rgb(203,213,224)\" fontSize=\"16\">\n    <p>\u81ea\u7136\u8bed\u8a00\u4ea4\u4e92</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"360\" topLeftY=\"220\" width=\"220\" height=\"180\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgba(255,255,255,0.1)\"/>\n  </fill>\n  <border color=\"rgba(255,255,255,0.2)\" width=\"1\"/>\n</shape>\n<shape type=\"text\" topLeftX=\"380\" topLeftY=\"250\" width=\"180\" height=\"40\">\n  <content textType=\"sub-headline\" textAlign=\