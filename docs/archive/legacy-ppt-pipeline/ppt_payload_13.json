{"slide": {"content": "<slide xmlns=\"http://www.larkoffice.com/sml/2.0\">\n  <style>\n    <fill>\n      <fillColor color=\"rgb(247,250,252)\"/>\n    </fill>\n  </style>\n  <data>\n    <shape type=\"text\" topLeftX=\"80\" topLeftY=\"40\" width=\"800\" height=\"50\">\n  <content textType=\"headline\" textAlign=\"center\" color=\"rgb(45,55,72)\" bold=\"true\" fontSize=\"40\">\n    <p>\u4e09\u5c42\u5546\u4e1a\u6a21\u5f0f</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"80\" topLeftY=\"360\" width=\"800\" height=\"90\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(59,130,246)\"/>\n  </fill>\n</shape>\n<shape type=\"text\" topLeftX=\"100\" topLeftY=\"380\" width=\"760\" height=\"30\">\n  <content textType=\"sub-headline\" textAlign=\"left\" color=\"rgb(255,255,255)\" bold=\"true\" fontSize=\"22\">\n    <p>To G \u653f\u5e9c</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"100\" topLeftY=\"415\" width=\"760\" height=\"30\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(255,255,255)\" fontSize=\"14\">\n    <p>\u667a\u80fd\u5ba2\u670d\u66ff\u4ee3\u4eba\u5de5\u7a97\u53e3\n\u57fa\u91d1\u667a\u80fd\u76d1\u7ba1\n\u964d\u4f4e30%-50%\u91cd\u590d\u54a8\u8be2</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"180\" topLeftY=\"260\" width=\"600\" height=\"90\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(56,161,105)\"/>\n  </fill>\n</shape>\n<shape type=\"text\" topLeftX=\"200\" topLeftY=\"280\" width=\"560\" height=\"30\">\n  <content textType=\"sub-headline\" textAlign=\"left\" color=\"rgb(255,255,255)\" bold=\"true\" fontSize=\"22\">\n    <p>To B \u5546\u4fdd/\u836f\u4f01</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"200\" topLeftY=\"315\" width=\"560\" height=\"30\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(255,255,255)\" fontSize=\"14\">\n    <p>\u6570\u636e\u8d4b\u80fd\uff1a\u7cbe\u51c6\u5b9a\u4ef7\u3001\u5feb\u901f\u7406\u8d54\n\u771f\u5b9e\u4e16\u754c\u6570\u636e\u5206\u6790</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"280\" topLeftY=\"160\" width=\"400\" height=\"90\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(221,107,32)\"/>\n  </fill>\n</shape>\n<shape type=\"text\" topLeftX=\"300\" topLeftY=\"180\" width=\"360\" height=\"30\">\n  <content textType=\"sub-headline\" textAlign=\"left\" color=\"rgb(255,255,255)\" bold=\"true\" fontSize=\"22\">\n    <p>To C \u4e2a\u4eba</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"300\" topLeftY=\"215\" width=\"360\" height=\"30\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(255,255,255)\" fontSize=\"14\">\n    <p>\u57fa\u7840\u6743\u76ca\u67e5\u8be2\uff1a\u514d\u8d39\n\u5065\u5eb7\u7ba1\u7406\u589e\u503c\u670d\u52a1\uff1a\u4ed8\u8d39</p>\n  </content>\n</shape>\n  </data>\n  <note>\n    <content textType=\"body\">\n      <p>\u4e09\u5c42\u5546\u4e1a\u6a21\u5f0f\uff1aTo G\u63d0\u4f9b\u667a\u80fd\u5ba2\u670d\u964d\u4f4e\u7ecf\u529e\u6210\u672c\uff1bTo B\u57fa\u4e8e\u53ef\u4fe1\u6570\u636e\u7a7a\u95f4\u63d0\u4f9b\u6570\u636e\u8d4b\u80fd\uff1bTo C\u57fa\u7840\u514d\u8d39\u3001\u589e\u503c\u4ed8\u8d39\u3002\u4ece\u533b\u4fdd\u7ba1\u5bb6\u5347\u7ea7\u4e3a\u5065\u5eb7\u7ba1\u5bb6\u3002</p>\n    </content>\n  </note>\n</slide>"}}