{"slide": {"content": "<slide xmlns=\"http://www.larkoffice.com/sml/2.0\">\n  <style>\n    <fill>\n      <fillColor color=\"rgb(247,250,252)\"/>\n    </fill>\n  </style>\n  <data>\n    <shape type=\"text\" topLeftX=\"80\" topLeftY=\"50\" width=\"800\" height=\"50\">\n  <content textType=\"headline\" textAlign=\"left\" color=\"rgb(45,55,72)\" bold=\"true\" fontSize=\"40\">\n    <p>\u5f20\u963f\u59e8\u7684\u56f0\u5883</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"80\" topLeftY=\"100\" width=\"800\" height=\"30\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(113,128,150)\" fontSize=\"18\">\n    <p>58\u5c81\uff0c\u9000\u4f11\u5de5\u4eba\uff0c\u4ea4\u4e86\u8fd9\u4e48\u591a\u5e74\u533b\u4fdd\uff0c\u7528\u7684\u65f6\u5019\u5374\u4ec0\u4e48\u90fd\u770b\u4e0d\u61c2</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"80\" topLeftY=\"160\" width=\"400\" height=\"300\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(255,255,255)\"/>\n  </fill>\n  <border color=\"rgb(226,232,240)\" width=\"1\"/>\n</shape>\n<shape type=\"rect\" topLeftX=\"110\" topLeftY=\"190\" width=\"48\" height=\"48\" radius=\"24\">\n  <fill>\n    <fillColor color=\"rgb(221,107,32)\"/>\n  </fill>\n</shape>\n<shape type=\"text\" topLeftX=\"170\" topLeftY=\"190\" width=\"280\" height=\"48\">\n  <content textType=\"sub-headline\" textAlign=\"left\" color=\"rgb(45,55,72)\" bold=\"true\" fontSize=\"24\">\n    <p>\u6392\u961f3\u5c0f\u65f6</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"110\" topLeftY=\"250\" width=\"340\" height=\"60\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(45,55,72)\" fontSize=\"18\">\n    <p>\u53ea\u4e3a\u95ee\u4e00\u53e5\uff1a\u6211\u8fd9\u4e2a\u80fd\u62a5\u591a\u5c11\uff1f</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"110\" topLeftY=\"330\" width=\"48\" height=\"48\" radius=\"24\">\n  <fill>\n    <fillColor color=\"rgb(229,62,62)\"/>\n  </fill>\n</shape>\n<shape type=\"text\" topLeftX=\"170\" topLeftY=\"330\" width=\"280\" height=\"48\">\n  <content textType=\"sub-headline\" textAlign=\"left\" color=\"rgb(45,55,72)\" bold=\"true\" fontSize=\"24\">\n    <p>\u770b\u4e0d\u61c2\u653f\u7b56</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"110\" topLeftY=\"390\" width=\"340\" height=\"50\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(45,55,72)\" fontSize=\"18\">\n    <p>\u8d77\u4ed8\u7ebf\u3001\u81ea\u4ed8\u6bd4\u4f8b\u3001\u4e59\u7c7b\u836f\u2026\u5168\u662f\u672f\u8bed</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"520\" topLeftY=\"160\" width=\"360\" height=\"300\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(26,54,93)\"/>\n  </fill>\n</shape>\n<shape type=\"text\" topLeftX=\"550\" topLeftY=\"200\" width=\"300\" height=\"60\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(255,255,255)\" fontSize=\"20\">\n    <p>\u6bcf\u5e74\u591a\u82b1</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"550\" topLeftY=\"250\" width=\"300\" height=\"80\">\n  <content textType=\"title\" textAlign=\"left\" color=\"rgb(221,107,32)\" bold=\"true\" fontSize=\"48\">\n    <p>\u4e0a\u5343\u5143</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"550\" topLeftY=\"340\" width=\"300\" height=\"80\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(255,255,255)\" fontSize=\"18\">\n    <p>\u9519\u8fc7\u653f\u7b56\u7ea2\u5229\uff0c\u4e0d\u77e5\u9053\u80fd\u4eab\u4ec0\u4e48\u5f85\u9047</p>\n  </content>\n</shape>\n  </data>\n  <note>\n    <content textType=\"body\">\n      <p>\u5f20\u963f\u59e8\uff0c58\u5c81\uff0c\u9000\u4f11\u5de5\u4eba\u3002\u6628\u5929\u521a\u770b\u5b8c\u95e8\u8bca\uff0c\u4eca\u5929\u4e00\u65e9\u5c31\u8d76\u5230\u533b\u4fdd\u5927\u5385\uff0c\u6392\u4e863\u4e2a\u5c0f\u65f6\uff0c\u53ea\u95ee\u4e86\u4e00\u53e5\u8bdd\u2014\u2014'\u6211\u8fd9\u4e2a\u80fd\u62a5\u591a\u5c11\uff1f'\u8fd9\u4e0d\u662f\u4e2a\u6848\uff0c\u8fd9\u662f8000\u4e07\u6c5f\u82cf\u53c2\u4fdd\u4eba\u6bcf\u5929\u90fd\u5728