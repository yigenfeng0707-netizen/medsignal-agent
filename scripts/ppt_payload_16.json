{"slide": {"content": "<slide xmlns=\"http://www.larkoffice.com/sml/2.0\">\n  <style>\n    <fill>\n      <fillColor color=\"linear-gradient(135deg,rgba(26,54,93,1) 0%,rgba(15,23,42,1) 100%)\"/>\n    </fill>\n  </style>\n  <data>\n    <shape type=\"text\" topLeftX=\"80\" topLeftY=\"100\" width=\"800\" height=\"60\">\n  <content textType=\"title\" textAlign=\"center\" color=\"rgb(255,255,255)\" bold=\"true\" fontSize=\"48\">\n    <p>\u8ba9\u6570\u636e\u591a\u8dd1\u8def</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"80\" topLeftY=\"170\" width=\"800\" height=\"60\">\n  <content textType=\"title\" textAlign=\"center\" color=\"rgb(255,255,255)\" bold=\"true\" fontSize=\"48\">\n    <p>\u8ba9\u7fa4\u4f17\u5c11\u8dd1\u817f</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"80\" topLeftY=\"240\" width=\"800\" height=\"70\">\n  <content textType=\"title\" textAlign=\"center\" color=\"rgb(221,107,32)\" bold=\"true\" fontSize=\"52\">\n    <p>\u8ba9\u5065\u5eb7\u65e9\u4e00\u6b65</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"80\" topLeftY=\"350\" width=\"800\" height=\"40\">\n  <content textType=\"sub-headline\" textAlign=\"center\" color=\"rgb(203,213,224)\" fontSize=\"24\">\n    <p>\u61c2\u533b\u4fdd \u00b7 \u61c2\u5065\u5eb7 \u00b7 \u61c2\u653f\u7b56</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"80\" topLeftY=\"430\" width=\"800\" height=\"30\">\n  <content textType=\"body\" textAlign=\"center\" color=\"rgb(255,255,255)\" fontSize=\"18\">\n    <p>\u51af\u4ea6\u6839  |  \u533b\u4fdd\u667a\u8111</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"80\" topLeftY=\"480\" width=\"800\" height=\"40\">\n  <content textType=\"headline\" textAlign=\"center\" color=\"rgb(255,255,255)\" bold=\"true\" fontSize=\"32\">\n    <p>\u8c22\u8c22\u5927\u5bb6\uff01</p>\n  </content>\n</shape>\n  </data>\n  <note>\n    <content textType=\"body\">\n      <p>\u56de\u5230\u5f20\u963f\u59e8\u7684\u6545\u4e8b\u3002\u6709\u4e86\u533b\u4fdd\u66