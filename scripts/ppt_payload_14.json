{"slide": {"content": "<slide xmlns=\"http://www.larkoffice.com/sml/2.0\">\n  <style>\n    <fill>\n      <fillColor color=\"rgb(247,250,252)\"/>\n    </fill>\n  </style>\n  <data>\n    <shape type=\"text\" topLeftX=\"80\" topLeftY=\"40\" width=\"800\" height=\"50\">\n  <content textType=\"headline\" textAlign=\"center\" color=\"rgb(45,55,72)\" bold=\"true\" fontSize=\"40\">\n    <p>\u4ece\u9ed1\u5ba2\u677e\u5230\u5168\u7701\u63a8\u5e7f</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"80\" topLeftY=\"180\" width=\"800\" height=\"6\" radius=\"3\">\n  <fill>\n    <fillColor color=\"rgb(226,232,240)\"/>\n  </fill>\n</shape>\n<shape type=\"rect\" topLeftX=\"180\" topLeftY=\"165\" width=\"30\" height=\"30\" radius=\"15\">\n  <fill>\n    <fillColor color=\"rgb(59,130,246)\"/>\n  </fill>\n</shape>\n<shape type=\"rect\" topLeftX=\"120\" topLeftY=\"230\" width=\"200\" height=\"200\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(255,255,255)\"/>\n  </fill>\n  <border color=\"rgb(226,232,240)\" width=\"1\"/>\n</shape>\n<shape type=\"text\" topLeftX=\"135\" topLeftY=\"250\" width=\"170\" height=\"50\">\n  <content textType=\"sub-headline\" textAlign=\"center\" color=\"rgb(59,130,246)\" bold=\"true\" fontSize=\"18\">\n    <p>Phase 1\n1-3\u4e2a\u6708</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"135\" topLeftY=\"310\" width=\"170\" height=\"90\">\n  <content textType=\"body\" textAlign=\"center\" color=\"rgb(45,55,72)\" fontSize=\"14\">\n    <p>\u6c99\u7bb1\u9a8c\u8bc1\n\u63a5\u5165\u6570\u636e\u8d4b\u80fd\u5b9e\u9a8c\u5ba4\n\u8131\u654f\u6570\u636e\u9a8c\u8bc1</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"460\" topLeftY=\"165\" width=\"30\" height=\"30\" radius=\"15\">\n  <fill>\n    <fillColor color=\"rgb(56,161,105)\"/>\n  </fill>\n</shape>\n<shape type=\"rect\" topLeftX=\"400\" topLeftY=\"230\" width=\"200\" height=\"200\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(255,255,255)\"/>\n  </fill>\n  <border color=\"rgb(226,232,240)\" width=\"1\"/>\n</shape>\n<shape type=\"text\" topLeftX=\"415\" topLeftY=\"250\" width=\"170\" height=\"50\">\n  <content textType=\"sub-headline\" textAlign=\"center\" color=\"rgb(56,161,105)\" bold=\"true\" fontSize=\"18\">\n    <p>Phase 2\n3-6\u4e2a\u6708</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"415\" topLeftY=\"310\" width=\"170\" height=\"90\">\n  <content textType=\"body\" textAlign=\"center\" color=\"rgb(45,55,72)\" fontSize=\"14\">\n    <p>\u533a\u53bf\u8bd5\u70b9\n1-2\u4e2a\u533a\u53bf\n\u8986\u76d65-10\u4e07\u4eba</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"740\" topLeftY=\"165\" width=\"30\" height=\"30\" radius=\"15\">\n  <fill>\n    <fillColor color=\"rgb(221,107,32)\"/>\n  </fill>\n</shape>\n<shape type=\"rect\" topLeftX=\"680\" topLeftY=\"230\" width=\"200\" height=\"200\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(255,255,255)\"/>\n  </fill>\n  <border color=\"rgb(226,232,240)\" width=\"1\"/>\n</shape>\n<shape type=\"text\" topLeftX=\"695\" topLeftY=\"250\" width=\"170\" height=\"50\">\n  <content textType=\"sub-headline\" textAlign=\"center\" color=\"rgb(221,107,32)\" bold=\"true\" fontSize=\"18\">\n    <p>Phase 3\n6-12\u4e2a\u6708</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"695\" topLeftY=\"310\" width=\"170\" height=\"90\">\n  <content textType=\"body\" textAlign=\"center\" color=\"rgb(45,55,72)\" fontSize=\"14\">\n    <p>\u5168\u7701\u63a8\u5e7f\n\u89c4\u6a21\u5316\u90e8\u7f72\n\u4f9d\u6258\u53ef\u4fe1\u6570\u636e\u7a7a\u95f4</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"100\" topLeftY=\"470\" width=\"200\" height=\"40\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(221,107,32)\" bold=\"true\" fontSize=\"18\">\n    <p>\ud83d\udc46 \u6211\u4eec\u5728\u8fd9\u91cc</p>\n  </content>\n</shape>\n  </data>\n  <note>\n    <content textType=\"body\">\n      <p>\u843d\u5730\u5206\u4e09\u6b65\uff1a\u5148\u5728\u6570\u636e\u8d4b\u80fd\u5b9e\u9a8c\u5ba4\u