color=\"rgb(45,55,72)\" bold=\"true\" fontSize=\"20\">\n    <p>\u53ef\u4fe1\u6570\u636e\u7a7a\u95f4\n\u5bf9\u9f50</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"545\" topLeftY=\"200\" width=\"310\" height=\"70\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(45,55,72)\" fontSize=\"15\">\n    <p>\u5bf9\u63a5\u6c5f\u82cf\u7701\n1+3+N\u6846\u67b6\n\u53ef\u7528\u4e0d\u53ef\u89c1</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"80\" topLeftY=\"320\" width=\"360\" height=\"170\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(255,255,255)\"/>\n  </fill>\n  <border color=\"rgb(226,232,240)\" width=\"1\"/>\n</shape>\n<shape type=\"rect\" topLeftX=\"80\" topLeftY=\"320\" width=\"8\" height=\"170\" radius=\"4\">\n  <fill>\n    <fillColor color=\"rgb(221,107,32)\"/>\n  </fill>\n</shape>\n<shape type=\"text\" topLeftX=\"105\" topLeftY=\"340\" width=\"310\" height=\"50\">\n  <content textType=\"sub-headline\" textAlign=\"left\" color=\"rgb(45,55,72)\" bold=\"true\" fontSize=\"20\">\n    <p>\u5065\u5eb7\u9884\u8b66\n\u521b\u65b0</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"105\" topLeftY=\"400\" width=\"310\" height=\"70\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(45,55,72)\" fontSize=\"15\">\n    <p>\u4ece\u4e8b\u540e\u62a5\u9500\n\u5230\u4e8b\u524d\u9884\u9632\n\u4e94\u7ef4\u5065\u5eb7\u753b\u50cf</p>\n  </content>\n</shape>\n<shape type=\"rect\" topLeftX=\"520\" topLeftY=\"320\" width=\"360\" height=\"170\" radius=\"12\">\n  <fill>\n    <fillColor color=\"rgb(255,255,255)\"/>\n  </fill>\n  <border color=\"rgb(226,232,240)\" width=\"1\"/>\n</shape>\n<shape type=\"rect\" topLeftX=\"520\" topLeftY=\"320\" width=\"8\" height=\"170\" radius=\"4\">\n  <fill>\n    <fillColor color=\"rgb(128,90,213)\"/>\n  </fill>\n</shape>\n<shape type=\"text\" topLeftX=\"545\" topLeftY=\"340\" width=\"310\" height=\"50\">\n  <content textType=\"sub-headline\" textAlign=\"left\" color=\"rgb(45,55,72)\" bold=\"true\" fontSize=\"20\">\n    <p>\u5168\u94fe\u8def\n\u53ef\u89e3\u91ca\u6027</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"545\" topLeftY=\"400\" width=\"310\" height=\"70\">\n  <content textType=\"body\" textAlign=\"left\" color=\"rgb(45,55,72)\" fontSize=\"15\">\n    <p>\u62a5\u9500\u6709\u516c\u5f0f\n\u653f\u7b56\u6709\u539f\u6587\n\u9884\u8b66\u6709\u8bc1\u636e</p>\n  </content>\n</shape>\n<shape type=\"text\" topLeftX=\"80\" topLeftY=\"510\" width=\"800\" height=\"30\">\n  <content textType=\"body\" textAlign=\"center\" color=\"rgb(45,55,72)\" bold=\"true\" fontSize=\"18\">\n    <p>\u4e0d\u505a\u9ed1\u7bb1 AI\uff0c\u505a\u53c2\u4fdd\u4eba\u80fd\u770b\u61c2\u3001\u80fd\u4fe1\u4efb\u7684 AI</p>\n  </content>\n</shape>\n  </data>\n  <note>\n    <content textType=\"body\">\n      <p>\u56db\u5927\u6280\u672f\u521b\u65b0\uff1a\u591a\u667a\u80fd\u4f53\u67b6\u6784\u5b9e\u73b0\u4e13\u4e1a\u5206\u5de5\u548c\u667a\u80fd\u8c03\u5ea6\uff1b\u53ef\u4fe1\u6570\u636e\u7a7a\u95f4\u5bf9\u9f50\u786e\u4fdd\u5b89\u5168\u5408\u89c4\uff1b\u5065\u5eb7\u9884\u8b66\u5b9e\u73b0\u4ece\u88ab\u52a8\u5230\u4e3b\u52a8\u7684\u8303\u5f0f\u8f6c\u53d8\uff1b\u5168\u94fe\u8def\u53ef\u89e3\u91ca\u8ba9\u6bcf\u4e2a\u51b3\u7b56\u90fd\u6709\u636e\u53ef\u67e5\u3002</p>\n    </content>\n  </note>\n</slide>"}}